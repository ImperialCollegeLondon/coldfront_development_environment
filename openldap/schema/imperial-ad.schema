attributetype ( 1.3.6.1.4.1.4203.666.11.1
    NAME 'sAMAccountName'
    DESC 'Active Directory account name'
    EQUALITY caseIgnoreMatch
    SUBSTR caseIgnoreSubstringsMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.4203.666.11.2
    NAME 'groupType'
    DESC 'Active Directory group type'
    EQUALITY integerMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
    SINGLE-VALUE )

objectclass ( 1.3.6.1.4.1.4203.666.11.3
    NAME 'group'
    DESC 'Minimal Active Directory-compatible group'
    SUP top
    STRUCTURAL
    MUST cn
    MAY ( member $ gidNumber $ groupType $ sAMAccountName $ description ) )
